<!-- Development harness of the SM86 frontend in the Ryujinx shader translator (docs/reference/shaders-sm86.md): translates SM86 programs to SPIR-V and MSL, and compares Maxwell output between two translator builds.
     Build outside the repository: dotnet build -c Release artifacts-path $W/sm86/artifacts. -p:RyuSrc=<dir> points it at another copy of the translator; -p:Baseline=true leaves out what an older copy lacks (the SM86 commands). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../../third_party/ryujinx</RyuSrc>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
